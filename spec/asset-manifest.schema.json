{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Context Ferry — Asset Manifest & Handoff Packet",
  "description": "标准化资产清单 + 交接包合一结构（v2）。既描述一次 AI 助手上下文迁移涉及的资产，也承载可机读的交接语义（阻塞/下一步/脱敏治理）。设计参考 mick-gsk/DevCD 的 handoff-packet 范式。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "assets"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0",
      "description": "资产清单格式版本，便于向后兼容。"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "生成时间（ISO 8601）。"
    },
    "migration_goal": {
      "type": "string",
      "description": "迁移动因，如 quota_exhaustion / account_switch / device_migration / team_handoff。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "源账号信息。",
      "properties": {
        "platform": { "type": "string", "description": "平台名，如 chatgpt/claude/cursor/workbuddy/codex" },
        "account_id": { "type": "string", "description": "账号标识（建议脱敏，如只保留哈希前缀）" },
        "exported_by": { "type": "string", "description": "操作者标识" },
        "repo_context": {
          "type": "object",
          "additionalProperties": false,
          "description": "来源代码仓库上下文（若适用）。",
          "properties": {
            "repository": { "type": ["string", "null"] },
            "branch": { "type": ["string", "null"] },
            "latest_commit": { "type": ["string", "null"] }
          }
        }
      },
      "required": ["platform", "account_id"]
    },
    "assets": {
      "type": "array",
      "description": "资产列表。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "asset_type", "name", "importance", "transferable"],
        "properties": {
          "asset_id": { "type": "string", "description": "唯一 ID" },
          "asset_type": {
            "type": "string",
            "enum": ["memory", "profile", "project_file", "conversation", "skill", "automation", "config", "integration"],
            "description": "资产类别。"
          },
          "name": { "type": "string" },
          "path": { "type": "string", "description": "资产在包内的相对路径" },
          "size_bytes": { "type": "integer" },
          "last_modified": { "type": "string", "format": "date-time" },
          "importance": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "价值权重，驱动 MVP 保留集筛选。"
          },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "与当前迁移目标的相关度（借鉴 DevCD relevant_artifacts.relevance）。"
          },
          "transferable": { "type": "boolean", "description": "是否可直接迁移" },
          "reauth_required": { "type": "boolean", "description": "凭证类资产仅迁元数据，需用户重授权" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "依赖的其他 asset_id，保证按序打包。"
          },
          "checksum": { "type": "string", "description": "sha256，用于完整性校验" },
          "notes": { "type": "string" }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "description": "交接包语义（多由 handoff 文档生成器在打包时填充；可空）。借鉴 DevCD handoff-packet。",
      "properties": {
        "last_attempt": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "上次尝试摘要。",
          "properties": {
            "summary": { "type": "string" },
            "outcome": { "type": "string" },
            "source": { "type": "string" },
            "type": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "last_failure": { "type": ["string", "null"] },
        "why_attempt_failed": { "type": ["string", "null"] },
        "do_not_repeat": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "rationale": { "type": ["string", "null"] }
            },
            "required": ["path"]
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["summary"]
          }
        },
        "suggested_next_action": { "type": ["string", "null"] },
        "policy_summary": {
          "type": "object",
          "additionalProperties": false,
          "description": "导出/脱敏治理摘要。",
          "properties": {
            "allowed": { "type": "boolean" },
            "operation": { "type": "string" },
            "reason": { "type": "string" },
            "withheld_data_classes": { "type": "array", "items": { "type": "string" } },
            "withheld_sources": { "type": "array", "items": { "type": "string" } }
          }
        },
        "withheld_context_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": { "type": "string" },
              "policy_reason": { "type": "string" },
              "safe_summary": { "type": "string" }
            },
            "required": ["category", "policy_reason", "safe_summary"]
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "本包完整性/可迁移置信度。"
        }
      }
    },
    "secret_inventory": {
      "type": "object",
      "additionalProperties": false,
      "description": "抽取出的敏感凭据清单（与明文资产分离，package 阶段加密进保险库 secrets 字段）。由 redact.build_secret_inventory 生成。",
      "properties": {
        "total": { "type": "integer", "description": "检出的凭据条数（0 表示无）" },
        "encrypted": { "type": "boolean", "description": "是否已加密（true=已进保险库；false=仅占位未加密）" },
        "by_category": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "各敏感类别计数，如 api_key/openai_key/aws_key 等"
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "description": "脱敏预览示例（类别:预览 (from 来源)）"
        }
      },
      "required": ["total", "encrypted", "by_category", "examples"]
    }
  }
}
